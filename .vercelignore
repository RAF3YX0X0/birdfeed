# What Vercel must not upload. The site is static: every other folder here is
# served at its own path, so nothing listed below may be referenced by a page.
# Checked by crawling all 35 pages (scrolling each, working every portfolio
# filter, opening a quick view and the case overlay) and recording every URL
# actually requested — nothing excluded appears in that list.

# The local dev server: deploying it would make Vercel run the site as a
# function, which can't see the static assets.
server.js

# Sources and tooling, not the built site.
scripts
fx/partials
*.md

# Everything the client sent us (see .gitignore) and the clone's leftovers:
# the other agency's images and videos, and the pages' hash-named media. The
# cloned sections that referenced them are hidden and no longer hydrate, so
# nothing asks for any of it. ~370MB.
_client
_legacy

# Chunks for pages that were retired and redirected (compare, pro, reseller,
# reviews, category); no page loads them.
_astro/fb-category-data.Ces8phR0-mm-b1.js
_astro/fb-category.CeUhbH1g-mm-c2-r2768d1-b8.js
